---
import type { MenuCategory } from "../data/menus";

interface Props {
  categories: MenuCategory[];
}

const { categories } = Astro.props;

function slugify(s: string) {
  return s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
---

<div class="menu-jump">
  {categories.map((cat) => (
    <a href={`#${slugify(cat.title)}`}>{cat.title}</a>
  ))}
</div>

<div class="menu-categories">
  {categories.map((cat) => (
    <section class="menu-category" id={slugify(cat.title)}>
      <h2>{cat.title}</h2>
      {cat.note && <p class="menu-note">{cat.note}</p>}
      <ul class="menu-items">
        {cat.items.map((item) => (
          <li>
            <div class="menu-item-row">
              <span class="menu-item-name">
                {item.name}
                {item.veggie && <span class="veggie" title="Vegetarisch">🌿</span>}
              </span>
              <span class="menu-item-price">€ {item.price}</span>
            </div>
            {item.description && <p class="menu-item-desc">{item.description}</p>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .menu-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 2rem 0 3rem;
    position: sticky;
    top: 85px;
    background: var(--color-surface);
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .menu-jump a {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.5rem 1rem;
  }

  .menu-jump a:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .menu-category {
    margin-bottom: 3rem;
    scroll-margin-top: 160px;
  }

  .menu-category h2 {
    border-bottom: 3px solid var(--color-primary);
    display: inline-block;
    padding-bottom: 0.3rem;
    margin-bottom: 0.4rem;
  }

  .menu-note {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: 1.3rem;
  }

  .menu-items {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem 2.5rem;
  }

  .menu-items li {
    padding-bottom: 0.8rem;
    border-bottom: 1px dashed var(--color-border);
  }

  .menu-item-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .menu-item-price {
    white-space: nowrap;
    color: var(--color-primary-dark);
  }

  .menu-item-desc {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.88rem;
    font-family: var(--font-body);
    font-weight: 400;
  }

  @media (max-width: 700px) {
    .menu-items {
      grid-template-columns: 1fr;
    }

    .menu-jump {
      top: 85px;
    }
  }
</style>
