---
import { locations } from "../data/locations";

const nav = [
  { href: "/", label: "Home" },
  { href: "/menu/", label: "Menu Vos in Tuinstraat" },
  { href: "/menu-theresiastraat/", label: "Menu Theresiastraat" },
  { href: "/over-ons/", label: "Over ons" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = new URL(Astro.request.url).pathname;
const primaryLocation = locations[0];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-badge">
        <img src="/images/logo-seal.png" alt="Gastronomia Lusso" width="64" height="64" />
      </span>
      <span class="logo-text">Gastronomia Lusso</span>
    </a>

    <nav class="main-nav" aria-label="Hoofdnavigatie">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn-primary call-btn" href={`tel:${primaryLocation.phoneHref}`}>
      Bel ons
    </a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: var(--color-surface);
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .logo-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-ink);
    flex-shrink: 0;
  }

  .logo-badge img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    white-space: nowrap;
  }

  .main-nav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    flex-wrap: wrap;
  }

  .main-nav a {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-ink);
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .main-nav a:hover,
  .main-nav a[aria-current="page"] {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  .call-btn {
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .main-nav {
      display: none;
    }
  }
</style>
