---
import { Image } from "astro:assets";
import logoSeal from "../assets/images/logo-seal.png";
import CallButton from "./CallButton.astro";

const nav = [
  { href: "/", label: "Home" },
  { href: "/menu/", label: "Menu Vos in Tuinstraat" },
  { href: "/menu-theresiastraat/", label: "Menu Theresiastraat" },
  { href: "/over-ons/", label: "Over ons" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-badge">
        <Image src={logoSeal} alt="Gastronomia Lusso" width={64} height={64} />
      </span>
      <span class="logo-text">Gastronomia Lusso</span>
    </a>

    <nav class="main-nav" aria-label="Hoofdnavigatie" id="main-nav">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <CallButton class="btn btn-primary call-btn call-btn-mobile" wrapperClass="call-btn-mobile-wrap" />
    </nav>

    <CallButton class="btn btn-primary call-btn call-btn-desktop" wrapperClass="call-btn-desktop-wrap" />

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Menu openen"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.getElementById("main-nav");

  if (toggle && nav) {
    const closeNav = () => {
      nav.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeNav);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeNav();
    });
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: var(--color-surface);
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .logo-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-ink);
    flex-shrink: 0;
  }

  .logo-badge img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .main-nav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    flex-wrap: wrap;
  }

  :global(.call-dropdown.call-btn-mobile-wrap) {
    display: none !important;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0;
  }

  .nav-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .main-nav a {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-ink);
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .main-nav a:hover,
  .main-nav a[aria-current="page"] {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  :global(.call-btn) {
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }

    :global(.call-dropdown.call-btn-desktop-wrap) {
      display: none !important;
    }

    .main-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-soft);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .main-nav.is-open {
      max-height: 80vh;
      overflow-y: auto;
    }

    .main-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.5rem;
    }

    .main-nav li {
      border-bottom: 1px solid var(--color-border);
    }

    .main-nav li:last-child {
      border-bottom: none;
    }

    .main-nav a {
      display: block;
      padding: 0.9rem 0;
    }

    :global(.call-dropdown.call-btn-mobile-wrap) {
      display: block !important;
    }

    :global(.call-btn-mobile) {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      box-sizing: border-box;
      padding: 0.85rem 1.6rem;
    }
  }

  @media (max-width: 420px) {
    .logo-text {
      display: none;
    }
  }
</style>
