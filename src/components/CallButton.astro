---
import { locations } from "../data/locations";

interface Props {
  class?: string;
  label?: string;
  wrapperClass?: string;
}

const { class: className = "btn btn-primary", label = "Bel ons", wrapperClass = "" } = Astro.props;
---

<div class={`call-dropdown ${wrapperClass}`}>
  <button type="button" class={`call-dropdown-trigger ${className}`} aria-haspopup="true" aria-expanded="false">
    {label}
  </button>
  <div class="call-dropdown-menu" role="menu">
    <div class="call-dropdown-panel">
      <p class="call-dropdown-title">Welke vestiging?</p>
      {locations.map((loc) => (
        <a role="menuitem" href={`tel:${loc.phoneHref}`}>
          <strong>{loc.name}</strong>
          <span>{loc.phone}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .call-dropdown {
    position: relative;
    display: inline-flex;
  }

  .call-dropdown-trigger {
    font: inherit;
  }

  .call-dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    padding-top: 0.6rem;
    display: none;
    z-index: 60;
  }

  .call-dropdown.is-open .call-dropdown-menu,
  .call-dropdown:hover .call-dropdown-menu,
  .call-dropdown:focus-within .call-dropdown-menu {
    display: block;
  }

  .call-dropdown-panel {
    min-width: 230px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: var(--shadow-soft);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: left;
  }

  .call-dropdown-title {
    margin: 0.2rem 0.6rem 0.3rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .call-dropdown-panel a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    color: var(--color-ink);
    transition: background 0.15s ease;
  }

  .call-dropdown-panel a:hover,
  .call-dropdown-panel a:focus-visible {
    background: var(--color-surface-alt);
  }

  .call-dropdown-panel strong {
    font-family: var(--font-heading);
    font-size: 0.9rem;
  }

  .call-dropdown-panel span {
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    :global(.main-nav) .call-dropdown {
      display: block;
      width: calc(100% - 3rem);
      margin: 1rem 1.5rem 1.25rem;
    }

    :global(.main-nav) .call-dropdown-trigger {
      width: 100%;
    }

    :global(.main-nav) .call-dropdown-menu {
      position: static;
      padding-top: 0;
    }

    :global(.main-nav) .call-dropdown-panel {
      box-shadow: none;
      border: none;
      padding: 0;
      margin-top: 0.6rem;
    }

    :global(.main-nav) .call-dropdown-panel a {
      border: 1px solid var(--color-border);
      margin-bottom: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .call-dropdown {
      display: block;
    }

    .call-dropdown-menu {
      position: static;
      padding-top: 0;
    }

    .call-dropdown-panel {
      width: 100%;
      box-sizing: border-box;
      margin-top: 0.6rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".call-dropdown").forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>(".call-dropdown-trigger");
    if (!trigger) return;

    const close = () => {
      dropdown.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
    };

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      const isOpen = dropdown.classList.toggle("is-open");
      trigger.setAttribute("aria-expanded", String(isOpen));
    });

    dropdown.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", close);
    });

    document.addEventListener("click", (event) => {
      if (!dropdown.contains(event.target as Node)) close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  });
</script>
