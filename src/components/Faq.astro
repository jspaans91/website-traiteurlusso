---
const faqs = [
  {
    q: "Wanneer kan ik wat bij jullie bestellen?",
    a: "Wilt u een bestelling plaatsen? Dan kunt u ons telefonisch bereiken van maandag t/m vrijdag van 08:00 tot 17:00 en zaterdag van 10:00 tot 17:00.",
  },
  {
    q: "Zijn jullie producten vers?",
    a: "Onze producten worden vers bereid om zo de beste kwaliteit te leveren.",
  },
  {
    q: "Kan ik ergens beoordelingen bekijken?",
    a: 'Beoordelingen die onze klanten achter gelaten hebben kun je bekijken via <a href="https://www.facebook.com/pg/Gastronomialusso/reviews/" target="_blank" rel="noopener">Facebook</a>, <a href="https://www.google.nl/search?q=gastronomia+lusso#lrd=0x47c5b73b9a04c963:0x89c52f09217aa7ba,1,,," target="_blank" rel="noopener">Google</a> en <a href="https://www.tripadvisor.nl/Restaurant_Review-g188633-d7995639-Reviews-Lusso-The_Hague_South_Holland_Province.html" target="_blank" rel="noopener">TripAdvisor</a>, zelf kunt u vanaf hier ook een beoordeling achterlaten.',
  },
];
---

<section class="section section-alt">
  <div class="container faq-wrap">
    <div>
      <p class="eyebrow">Veelgestelde vragen</p>
      <h2 class="section-title">Alles wat je wilt weten</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p set:html={item.a} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-wrap {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 2.5rem;
    align-items: start;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.1rem 1.4rem;
  }

  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .faq-item p {
    margin-top: 0.8rem;
    margin-bottom: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .faq-item p :global(a) {
    color: var(--color-primary-dark);
    font-weight: 600;
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .faq-wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
