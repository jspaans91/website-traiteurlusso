---
import { Image } from "astro:assets";
import { locations } from "../data/locations";
import broodjeImage from "../assets/images/broodje.jpeg";
---

<section class="hero">
  <div class="hero-media">
    <Image
      src={broodjeImage}
      alt="Vers belegd Italiaans broodje bij Gastronomia Lusso"
      widths={[640, 960, 1440, 2000]}
      sizes="100vw"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="container hero-content">
    <p class="eyebrow">Italiaanse delicatessen in Den Haag</p>
    <h1>Al 15 jaar de plek voor Italiaanse Specialiteiten in Den Haag</h1>
    <p class="section-lead">
      Dagelijks vers bereide broodjes, salades en pasta's, midden in het
      centrum van Den Haag — tegenover Hotel Des Indes en aan de
      Theresiastraat.
    </p>
    <div class="hero-tags">
      <span>Panini</span>
      <span>Catering</span>
      <span>Traiteur</span>
    </div>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/menu/">Bekijk volledige menu</a>
      <a class="btn btn-outline" href="#locaties">Onze locaties</a>
    </div>
    <div class="hero-phones">
      {locations.map((loc) => (
        <a href={`tel:${loc.phoneHref}`}>
          <strong>{loc.name}</strong> {loc.phone}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 82vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.1) 0%, rgba(10, 10, 10, 0.78) 100%),
      linear-gradient(90deg, rgba(10, 10, 10, 0.75) 0%, rgba(10, 10, 10, 0.15) 60%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 6rem;
    padding-bottom: 4rem;
    max-width: 680px;
  }

  .eyebrow {
    color: var(--color-primary);
  }

  h1 {
    font-size: clamp(2.1rem, 4.5vw, 3.25rem);
    margin-bottom: 1rem;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .hero-content .section-lead {
    color: rgba(255, 255, 255, 0.88);
    max-width: 560px;
  }

  .hero-tags {
    display: flex;
    gap: 0.6rem;
    margin: 1.4rem 0;
    flex-wrap: wrap;
  }

  .hero-tags span {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--font-heading);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin: 1.5rem 0;
    flex-wrap: wrap;
  }

  .hero-content .btn-outline {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }

  .hero-content .btn-outline:hover {
    background: #fff;
    color: var(--color-ink);
  }

  .hero-phones {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .hero-phones a {
    color: #fff;
  }

  .hero-phones strong {
    font-family: var(--font-heading);
    display: block;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 72vh;
      align-items: flex-end;
    }

    .hero-content {
      text-align: center;
      max-width: none;
      margin: 0 auto;
      padding-top: 4rem;
    }

    .hero-content .section-lead {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-tags,
    .hero-actions,
    .hero-phones {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 85vh;
    }
  }
</style>
