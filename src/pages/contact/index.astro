---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { locations, openingHours } from "../../data/locations";
import contactHero from "../../assets/images/contact-hero.jpg";
---

<Layout title="Contact" description="Neem contact op met Gastronomia Lusso in Den Haag voor vragen of bestellingen.">
  <section class="page-hero">
    <div class="page-hero-media">
      <Image
        src={contactHero}
        alt="Koffie en belegd broodje met prosciutto en tomaat bij Gastronomia Lusso"
        widths={[640, 960, 1440, 2000]}
        sizes="100vw"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container page-hero-content">
      <p class="eyebrow">Contact</p>
      <h1 class="section-title">Neem contact met ons op voor al je vragen</h1>
      <p class="section-lead">Bestellen? Bel vóór 10:00 uur en vanaf 4 broodjes.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice">
        <strong>Let op:</strong> zorg ervoor dat je de juiste vestiging kiest
        bij het plaatsen van je bestelling, zodat we je zo goed mogelijk van
        dienst kunnen zijn.
      </div>

      <h2 class="locations-title">Onze locaties</h2>
      <div class="contact-grid">
        {locations.map((loc) => (
          <article class="contact-card">
            <h3>{loc.name}</h3>
            <p>{loc.street}<br />{loc.postal}<br />{loc.city}</p>
            <p class="label">Telefoonnummer:</p>
            <a class="phone" href={`tel:${loc.phoneHref}`}>{loc.phone}</a>
            <a class="email" href={`mailto:${loc.email}`}>{loc.email}</a>
            <a
              class="btn btn-outline"
              href={`https://www.google.com/maps/dir/?api=1&destination=${loc.mapsQuery}`}
              target="_blank"
              rel="noopener"
            >
              Routeplanner {loc.name}
            </a>
          </article>
        ))}

        <article class="contact-card hours-card">
          <h3>Openingstijden</h3>
          <ul>
            {openingHours.map((o) => (
              <li><span>{o.days}</span><span>{o.hours}</span></li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    min-height: 64vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
  }

  .page-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.15) 0%, rgba(10, 10, 10, 0.8) 100%);
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    padding-top: 4rem;
    padding-bottom: 2.5rem;
  }

  .page-hero-content .eyebrow {
    color: var(--color-primary);
  }

  .page-hero-content .section-title {
    margin-bottom: 0.5rem;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .page-hero-content .section-lead {
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .page-hero {
      min-height: 38vh;
    }
  }

  .notice {
    background: #fff7e0;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius);
    padding: 1.1rem 1.4rem;
    font-size: 0.92rem;
    margin: 1.5rem 0 3rem;
  }

  .locations-title {
    margin-bottom: 1.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .contact-card {
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.8rem;
  }

  .contact-card h3 {
    margin-bottom: 0.6rem;
  }

  .contact-card p {
    color: var(--color-muted);
    font-size: 0.92rem;
    margin-bottom: 0.3rem;
  }

  .label {
    margin-top: 1rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .phone {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .email {
    display: block;
    font-size: 0.88rem;
    color: var(--color-primary-dark);
    margin-bottom: 1.2rem;
  }

  .hours-card ul {
    list-style: none;
  }

  .hours-card li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  .hours-card li:last-child {
    border-bottom: none;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
