---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import gevelImage from "../../assets/images/gevel.jpeg";
import logoSeal from "../../assets/images/logo-seal.png";
import overOnsHero from "../../assets/images/over-ons-hero.jpg";
---

<Layout title="Ons verhaal" description="Het verhaal van Gastronomia Lusso: 15 jaar Italiaanse passie in Den Haag.">
  <section class="page-hero">
    <div class="page-hero-media">
      <Image
        src={overOnsHero}
        alt="De winkelpui van Gastronomia Lusso met bakfiets in Den Haag"
        widths={[640, 960, 1440, 2000]}
        sizes="100vw"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container page-hero-content">
      <p class="eyebrow">La nostra storia</p>
      <h1 class="section-title">Ons verhaal</h1>
    </div>
  </section>

  <section class="section story">
    <div class="container story-grid">
      <div>
        <p>
          Onze Italiaanse droom begon 15 jaar geleden met het openen van een
          lunchroom in hartje Den Haag. Inmiddels werkt de tweede generatie
          ook mee in ons familiebedrijf. Wij blijven ons iedere dag inzetten
          om de beste kwaliteit en service te bieden voor onze klanten.
        </p>
        <p class="italic">Piu di 15 anni di passione....</p>
      </div>
      <div class="story-media">
        <Image src={gevelImage} alt="De gevel van Gastronomia Lusso in Den Haag" class="story-image" />
        <Image src={logoSeal} alt="Lusso keurmerk: Con Amore, Caffé Pasta Panini, The Hague" class="story-seal" />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container feature-grid">
      <article>
        <h2>Gevestigd in Den Haag centrum</h2>
        <p>U vindt ons tegenover Hotel Des Indes en aan de Theresiastraat 48.</p>
      </article>
      <article>
        <h2>Italiaanse koffie</h2>
        <p>Voor de perfecte espresso komt u naar Lusso.</p>
      </article>
      <article>
        <h2>Bereid met liefde</h2>
        <p>Alles wordt dagelijks vers en met zorg bereid, zoals het in Italië gewoon is.</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    min-height: 64vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
  }

  .page-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.15) 0%, rgba(10, 10, 10, 0.8) 100%);
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    padding-top: 4rem;
    padding-bottom: 2.5rem;
  }

  .page-hero-content .eyebrow {
    color: var(--color-primary);
  }

  .page-hero-content .section-title {
    margin-bottom: 0;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 900px) {
    .page-hero {
      min-height: 38vh;
    }
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .story-grid > * {
    min-width: 0;
  }

  .italic {
    font-style: italic;
    color: var(--color-muted);
  }

  .story-media {
    position: relative;
  }

  .story-image {
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    aspect-ratio: 4/3;
    object-fit: cover;
    width: 100%;
  }

  .story-seal {
    position: absolute;
    bottom: -28px;
    right: -28px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: var(--shadow-soft);
    padding: 8px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .feature-grid article {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.8rem;
  }

  @media (max-width: 900px) {
    .story-grid,
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .story-media {
      order: -1;
    }

    .story-seal {
      width: 100px;
      height: 100px;
      bottom: -16px;
      right: -16px;
    }
  }
</style>
