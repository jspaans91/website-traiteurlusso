---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import MenuSection from "../../components/MenuSection.astro";
import { vosMenu } from "../../data/menus";
import menuHero from "../../assets/images/menu-vos-hero.jpg";
---

<Layout title="Menu Vos in Tuinstraat" description="Het volledige menu van Gastronomia Lusso aan de Vos in Tuinstraat in Den Haag.">
  <section class="page-hero">
    <div class="page-hero-media">
      <Image
        src={menuHero}
        alt="Belegd broodje met prosciutto, mozzarella en tomaat van Gastronomia Lusso"
        widths={[640, 960, 1440, 2000]}
        sizes="100vw"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container page-hero-content">
      <p class="eyebrow">Menu</p>
      <h1 class="section-title">Menu Vos in Tuinstraat</h1>
      <p class="section-lead">Onze producten worden vers bereid.</p>
    </div>
  </section>

  <section class="section menu-body">
    <div class="container">
      <MenuSection categories={vosMenu} />
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    position: relative;
    min-height: 64vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
  }

  .page-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.15) 0%, rgba(10, 10, 10, 0.8) 100%);
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    padding-top: 4rem;
    padding-bottom: 2.5rem;
  }

  .page-hero-content .eyebrow {
    color: var(--color-primary);
  }

  .page-hero-content .section-title {
    margin-bottom: 0.5rem;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .page-hero-content .section-lead {
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .page-hero {
      min-height: 38vh;
    }
  }

  .menu-body {
    padding-top: 1rem;
  }
</style>
